{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "idlewa.com" }],
      "destination": "https://www.idilewa.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.idlewa.com" }],
      "destination": "https://www.idilewa.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "idilewa.com" }],
      "destination": "https://www.idilewa.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "idilewa-com.vercel.app" }],
      "destination": "https://www.idilewa.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "idilewa-com-tapee2.vercel.app" }],
      "destination": "https://www.idilewa.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "idlewa.com" }],
      "destination": "https://www.idilewa.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.idlewa.com" }],
      "destination": "https://www.idilewa.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "idilewa.com" }],
      "destination": "https://www.idilewa.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "idilewa-com.vercel.app" }],
      "destination": "https://www.idilewa.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "idilewa-nwxk3xs7i-tapee2.vercel.app" }],
      "destination": "https://www.idilewa.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/canva/status",
      "destination": "/api/translate?service=canva&operation=status"
    },
    {
      "source": "/api/canva/start",
      "destination": "/api/translate?service=canva&operation=start"
    },
    {
      "source": "/api/canva/callback",
      "destination": "/api/translate?service=canva&operation=callback"
    },
    {
      "source": "/api/canva/designs",
      "destination": "/api/translate?service=canva&operation=designs"
    },
    {
      "source": "/api/chat",
      "destination": "/api/translate?service=chat"
    },
    {
      "source": "/api/code/languages",
      "destination": "/api/code/run?operation=languages"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), payment=(self), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" }
      ]
    }
  ]
}
