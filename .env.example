# Supabase Configuration Template
# Frontend/browser config: use either VITE_* or the legacy public names below.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Backward-compatible public variables accepted by the app and Vite build.
SUPABASE_PUBLIC_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Server-side guardian approval. Keep these private; never use a VITE_ prefix.
# Apply supabase_guardian_consent.sql to the configured Supabase project before enabling this flow.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GUARDIAN_TOKEN_SECRET=generate-a-random-secret-of-at-least-32-characters
APP_BASE_URL=https://www.idilewa.com
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Idilewa <guardian@your-verified-domain.example>

# Server-side Plotweaver API key. Keep private; never use a VITE_ prefix.
# The backend also accepts the legacy `Idilewa` variable name.
PLOTWEAVER_API_KEY=your-plotweaver-api-key
# Optional when the static frontend and /api functions are hosted on different origins.
VITE_PLOTWEAVER_API_BASE_URL=https://www.idilewa.com
IDILEWA_ALLOWED_ORIGINS=https://tpsalm.github.io

# Local AI Conversation development. Never expose these through VITE_ variables.
# Production must use a private HTTPS Ollama host; Vercel cannot reach developer localhost.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_API_KEY=
AI_RATE_LIMIT_HMAC_KEY=generate-a-random-secret-of-at-least-32-characters

# Server-side Google Cloud Translation API key. Restrict it to Cloud Translation
# and set a billing quota in Google Cloud; never use a VITE_ prefix.
GOOGLE_TRANSLATE_API_KEY=your-google-cloud-translation-api-key

# Server-side private Judge0 CE runner. Never expose its URL or token via VITE_ variables.
JUDGE0_URL=https://your-private-judge0-service.example
JUDGE0_AUTH_TOKEN=your-private-runner-token
